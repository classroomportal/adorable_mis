<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to ~/Library/LaunchAgents/org.classroomportal.adorablemis.backup.plist,
  replacing YOUR_USERNAME with your Mac username (run `whoami` to check),
  then load it — see README.md step 5.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.classroomportal.adorablemis.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USERNAME/adorable_mis/scripts/backup/backup_supabase.sh</string>
  </array>

  <!-- Runs daily at 23:00. If the Mac is asleep at that time, macOS runs it
       shortly after the next wake — but if this Mac is regularly off
       overnight, pick a time it's normally on instead. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/AdorableMIS-Backups/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/AdorableMIS-Backups/backup.error.log</string>
</dict>
</plist>
