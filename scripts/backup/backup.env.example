# Copy this file to backup.env (same folder) and fill in real values.
# backup.env is gitignored — never commit it, it holds your DB password.

# Get this from: Supabase Dashboard -> adorable_mis project -> Project
# Settings -> Database -> Connection string.
#
# Free-plan gotcha: the "direct connection" host is IPv6-only unless the
# IPv4 add-on is purchased, and most home/school networks are IPv4-only.
# If the direct string times out, use the "Connection pooling" string
# instead (Session mode, port 5432) — it looks like:
#   postgresql://postgres.drjtcegtucovhbyfdpbx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL="postgresql://postgres.drjtcegtucovhbyfdpbx:YOUR-DB-PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Where the local copy lives on this Mac.
LOCAL_BACKUP_DIR="$HOME/AdorableMIS-Backups"

# A folder inside your school Google Drive sync (Google Drive for Desktop
# app, signed in with the school account). Find the exact base path with:
#   ls ~/Library/CloudStorage/
# Then create a subfolder in "My Drive" for this and point at it here.
CLOUD_BACKUP_DIR="$HOME/Library/CloudStorage/GoogleDrive-you@abc.sch.ng/My Drive/AdorableMIS-Backups (Encrypted)"

# How many days of backups to keep, locally and in the cloud folder.
RETENTION_DAYS=30

# macOS Keychain "service" name under which you stored the gpg passphrase
# used to encrypt the copy that goes to Google Drive (see README.md, setup
# step 3). Leave blank to skip encryption (not recommended — this data
# includes medical notes, national ID numbers, addresses and phone numbers).
GPG_KEYCHAIN_SERVICE="AdorableMIS-BackupPassphrase"
